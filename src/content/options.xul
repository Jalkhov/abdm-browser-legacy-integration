<?xml version="1.0"?>
<?xml-stylesheet href="chrome://global/skin/" type="text/css"?>
<?xml-stylesheet href="chrome://abdm_legacy/content/options.css" type="text/css"?>
<window id="abdm-options" title="AB Download Manager - Options"
    xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
    width="540" height="480">

    <script type="application/javascript" src="chrome://abdm_legacy/content/options.js"/>

    <vbox id="abdm-options-body" flex="1">

        <!-- Header/Logo Area -->
        <hbox align="center" style="margin-bottom: 15px;">
            <image src="chrome://abdm_legacy/skin/icons/icon-32.png" width="32" height="32" style="margin-right: 10px;"/>
            <label value="AB Download Manager Settings" class="abdm-header-title"/>
        </hbox>

        <groupbox>
            <caption label="General Integration"/>
            <checkbox id="opt-autoCaptureLinks" label="Auto Capture Links"/>
            <description class="abdm-hint" style="margin: 0 0 10px 28px;">
                When you click on a link in your browser, it will be automatically captured for download by the App.
            </description>
        </groupbox>

        <groupbox>
            <caption label="Connection"/>
            <label value="Server URL:" control="opt-http-endpoint"/>
            <textbox id="opt-http-endpoint" style="margin-bottom: 5px;"/>
            <label value="Send method:" control="opt-method"/>
            <menulist id="opt-method" style="margin-bottom: 5px;">
                <menupopup>
                    <menuitem label="Auto (HTTP, then protocol)" value="auto"/>
                    <menuitem label="HTTP" value="http"/>
                    <menuitem label="Protocol (abdm://)" value="protocol"/>
                    <menuitem label="External process" value="process"/>
                </menupopup>
            </menulist>
            <label value="API Key (leave empty if not enabled in ABDM):" control="opt-api-key"/>
            <textbox id="opt-api-key" style="margin-bottom: 5px;"/>
            <description class="abdm-hint" style="margin-bottom: 5px;">
                Found in AB Download Manager &gt; Settings &gt; Browser Integration. Sent as the X-API-Key header.
            </description>
            <hbox pack="end" spacing="5" align="center">
                <label id="opt-api-status" value="" class="abdm-hint"/>
                <button id="opt-test-connection" label="Test connection"/>
            </hbox>
        </groupbox>

        <groupbox flex="1">
            <caption label="File Capture &amp; Filters"/>

            <label value="Registered file extensions (space separated):" control="opt-registered-filetypes"/>
            <textbox id="opt-registered-filetypes" multiline="true" flex="1" rows="3" style="margin-bottom: 5px;"/>
            <description class="abdm-hint" style="margin-bottom: 15px;">
                Enter each file extension you want to be captured (e.g., zip rar mp4).
            </description>

            <label value="Minimum file size (KB, 0 = no minimum):" control="opt-min-size"/>
            <textbox id="opt-min-size" style="margin-bottom: 15px;"/>

            <label value="Ignored URL patterns (one per line):" control="opt-ignored-patterns"/>
            <textbox id="opt-ignored-patterns" multiline="true" flex="1" rows="3" style="margin-bottom: 5px;"/>
            <hbox pack="end">
                <button id="opt-reset-patterns" label="Reset to default"/>
            </hbox>
        </groupbox>

        <separator class="groove" style="margin: 10px 0;"/>

        <hbox pack="end" spacing="5">
            <button label="Save" oncommand="ABDMOptions.save()" icon="accept"/>
            <button label="Close" oncommand="window.close()" icon="cancel"/>
        </hbox>
    </vbox>
</window>
